# Q-FLARE frontend environment template.
# Copy to `.env` (or `.env.local`) and adjust for your setup.

# Backend base URL. Empty string (default) = same origin via the Vite dev proxy
# (vite.config.ts proxies /api to the Node backend).
VITE_API_BASE_URL=

# AI Analytics sample-data fallback:
#  - "false" → forces live backends even in dev (disables the sample fallback;
#    Quantum Optimization chooses the HTTP adapter).
#  - unset/other → the sample fallback is permitted, but ONLY in a dev build
#    (import.meta.env.DEV). Production builds never serve sample data.
# Quantum Optimization's existing adapter selection (mock/http) keys off this
# same flag (see services/optimization/adapter.ts).
VITE_USE_MOCK_DATA=