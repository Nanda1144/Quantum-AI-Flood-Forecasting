# ------------------------------------------------------------------------------
# 1. General & System Settings
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Backend Gateway (Node.js/Express - Port 3000)
# ------------------------------------------------------------------------------
PORT=3000

# Database Connection: "postgres" for live Supabase/PostgreSQL, "memory" for in-memory testing
DATABASE_MODE=postgres
DATABASE_URL=postgresql://postgres.mmywcunzmyblksavshfu:%40cCnanda1411441@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Authentication & RBAC (Set to false for direct command-center access without login)
AUTH_ENABLED=false
JWT_SECRET=@cCnandakishore141144111918815195
JWT_EXPIRES_IN=800h

# Forecasting Freshness & Staleness Threshold (ms)
FRESHNESS_STALE_MS=90000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1200

# Model Selection Metric (mae, rmse, r2, nse, inferenceTime)
MODEL_SELECTION_METRIC=r2

# Optimization Job Configuration
OPTIMIZATION_FALLBACK_POLICY=retry_simulator
OPTIMIZATION_EXECUTION_TIMEOUT_MS=120000
OPTIMIZATION_EXHAUSTIVE_LIMIT=18
OPTIMIZATION_QUBO_INLINE_LIMIT=12
OPTIMIZATION_RUN_LIMIT_MAX=10

# ------------------------------------------------------------------------------
# 3. AI Service (Python FastAPI - Port 8000)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_MS=5000
FORECAST_ENGINE=reference
AI_SERVICE_CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 4. Quantum Optimization Service (Python FastAPI - Port 8100)
# ------------------------------------------------------------------------------
QUANTUM_SERVICE_HOST=0.0.0.0
QUANTUM_SERVICE_PORT=8100
QUANTUM_SERVICE_URL=http://localhost:8100
QUANTUM_REQUEST_TIMEOUT_MS=15000
QUANTUM_SERVICE_CORS_ORIGINS=*
