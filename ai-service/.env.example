# Q-FLARE AI service configuration
# Copy to .env and adjust locally. Never commit .env.

# HTTP listener
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Engine resolution (see app/engines/factory.py):
#   "reference"                      -> deterministic contract engine; the labelled
#                                       demo/fallback, and the code default so the
#                                       team's run is never switched behind its back
#   "module.path:EngineClass"        -> any ForecastEngine implementation, constructed
#                                       with zero arguments
# B4: Navya's Phase 1-8 hydro pipeline is the configured serving engine:
FORECAST_ENGINE=app.engines.hydro.engine:HydroForecastEngine

# Hydro engine prerequisites (app/engines/hydro/config.py). Until a dataset, target
# units and a flood-threshold policy are configured the engine refuses to serve
# (502 FORECAST_ENGINE_ERROR: dependency blocked) -- it never substitutes a baseline
# and never invents a threshold. The placeholders below are DEMO guidance; the CSV
# is produced by the labelled synthetic writer (training.py --write-synthetic <path>):
#   HYDRO_DATASET_PATH=<path to hydrological CSV>
#   HYDRO_DATASET_TYPE=synthetic        # 'real' only for measured, licensed data
#   HYDRO_DATASET_REFERENCE=<stable lineage id>
#   HYDRO_DATASET_LICENSE=<license>
#   HYDRO_SAMPLING_INTERVAL=1h
#   HYDRO_STATION_REFERENCE=<station / reach / gauge id>
#   HYDRO_TARGET=water_level
#   HYDRO_TARGET_UNITS=<units, e.g. m>
#   HYDRO_FORECAST_HORIZON_HOURS=6
#   HYDRO_FLOOD_THRESHOLD=<official flood stage, same units as target>
#   HYDRO_FLOOD_THRESHOLD_SOURCE=<authority + document>
#   HYDRO_RISK_THRESHOLD_POLICY=pending  # 'approved' only after sign-off
#   HYDRO_RISK_BANDS=0.1,0.3,0.6,0.9

# Comma-separated origins allowed to call this service (usually the Node backend)
AI_SERVICE_CORS_ORIGINS=*