# Q-FLARE AI service configuration
# Copy to .env and adjust locally. Never commit .env.

# HTTP listener
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Engine: "reference" (deterministic contract engine) or a dotted path to
# Navya's live engine class, e.g. pipeline.modules.gru:GruFloodNetEngine
FORECAST_ENGINE=reference

# Comma-separated origins allowed to call this service (usually the Node backend)
AI_SERVICE_CORS_ORIGINS=*