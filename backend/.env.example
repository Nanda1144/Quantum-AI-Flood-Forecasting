# Backend configuration — copy to .env and fill in real values.
# IMPORTANT: never commit real credentials here; .env is gitignored.
# Server-side only. Never expose these to the frontend.

NODE_ENV=development

# Port the Vite proxy forwards /api to (frontend expects this).
PORT=3000

# Postgres connection. DATABASE_MODE=memory uses in-memory repositories
# (tests / no-DB demo). Default is postgres.
# For a cloud (e.g. Supabase) instance append ?sslmode=require&uselibpqcompat=true.
DATABASE_MODE=postgres
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/qflare

# Set AUTH_ENABLED=false only for local demos WITHOUT a frontend token flow.
# Production must be true (all /api routes require a JWT).
AUTH_ENABLED=true
JWT_SECRET=<at-least-16-chars-random-secret>
JWT_EXPIRES_IN=800h

# Persistent demo users as JSON. Omit to use DEFAULT_USERS
# (admin/qflare-admin, operator/qflare-operator, viewer/qflare-viewer).
# AUTH_USERS={"alice":{"password":"s3cret","role":"admin"}}

# AI FastAPI forecasting service.
AI_SERVICE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_MS=5000

# Forecasts older than this (ms) are reported as stale.
FRESHNESS_STALE_MS=90000

# Rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1200

# Stricter per-window cap on POST /api/optimization/run (expensive pipeline).
OPTIMIZATION_RUN_LIMIT_MAX=10

# Quantum FastAPI optimization service (QUBO construction + QAOA execution).
QUANTUM_SERVICE_URL=http://localhost:8100
QUANTUM_REQUEST_TIMEOUT_MS=15000

# Optimization orchestration.
# Wall-clock cap on a whole optimization job.
OPTIMIZATION_EXECUTION_TIMEOUT_MS=120000
# Fallback when the configured quantum path fails:
#   retry_simulator (default) | classical_only | error
OPTIMIZATION_FALLBACK_POLICY=retry_simulator
# Maximum candidate count the classical reference solver exhaustively solves.
OPTIMIZATION_EXHAUSTIVE_LIMIT=18