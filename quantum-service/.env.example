# quantum-service environment (all optional).

QUANTUM_SERVICE_HOST=0.0.0.0
QUANTUM_SERVICE_PORT=8100

# Force failure drills so the backend fallback policy is verifiable live.
QUANTUM_QUBO_DISABLED=false
QUANTUM_FORCE_AER_DOWN=false
QUANTUM_FORCE_HARDWARE_DOWN=false

# Job lifecycle persistence (quantum_jobs + quantum_results tables).
# Empty = ephemeral per-process SQLite database under the OS temp dir.
# QUANTUM_DB_PATH=./quantum_jobs.db

# Optional bearer-token gate. When set, every request except /health must carry
# `Authorization: Bearer <token>`. Mirror it via the backend's QUANTUM_API_TOKEN.
# QUANTUM_API_TOKEN=

# When true, an Aer/IBM failure degrades the SAME job to the clearly-marked
# qflare simulator (mode_used=simulator, fallback_applied=true). Default false
# keeps the strict contract — the backend's retry_simulator ladder owns fallback.
QUANTUM_FALLBACK_ENABLED=false

# Pacing knob (ms, capped at 5000) so queued/running states are observable.
# QUANTUM_JOB_DELAY_MS=0

# How long GET /quantum/result/:id waits for a terminal state (ms).
# QUANTUM_RESULT_WAIT_MS=30000

# IBM Quantum credentials for the live-QPU execution path.
# QISKIT_IBM_TOKEN=